# =============================================
# OpenWeatherMap API Configuration
# =============================================
# REQUIRED: Get your free API key from https://openweathermap.org/api
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY_HERE
# Optional: Units (metric, imperial, kelvin) - default: metric
OPENWEATHER_UNITS=metric
# Optional: Language code (en, es, etc.) - default: en
OPENWEATHER_LANG=en

# Market Data APIs Configuration
# REQUIRED for market slides (Gold, Silver, Oil, FX) to display real data

# Metals API (Gold & Silver)
# Get your API key from https://metals.dev/
# Free tier: 50 requests/day
METALS_API_URL=https://api.metals.dev
METALS_API_KEY=your-metals-api-key

# Oil API (WTI & Brent Crude Oil)
# Get your API key from https://oilpriceapi.com/
# Free tier: 100 requests/day
OIL_API_URL=https://api.oilpriceapi.com/v1/prices/latest
OIL_API_KEY=your-oil-api-key

# FX API (Foreign Exchange - EUR, JPY, GBP)
# Configurar FX_API_KEY en Vercel (Variables de Entorno) para producción.
FX_API_URL=https://api.exchangerate.host/latest
FX_API_KEY=

# Roxom API (BTC live price used by debt/markets endpoints)
# REQUIRED in production. In Cloudflare, set it as Worker Secret:
# wrangler secret put ROXOM_API_KEY
ROXOM_API_KEY=your-roxom-api-key

# Copper (iShares Copper and Metals Mining ETF) via Polygon.io
# Get API key from https://polygon.io/
# IMPORTANTE: En producción (Vercel, Netlify, etc.) hay que definir POLYGON_API_KEY en Variables de Entorno del proyecto; si no, copper mostrará "—".
POLYGON_API_KEY=your-polygon-api-key
# Ticker por defecto: ICOP (iShares Copper and Metals Mining ETF, NASDAQ)
# POLYGON_COPPER_TICKER=ICOP

# Optional: Custom rotation interval in seconds (default: 25)
ROTATION_SECONDS=25

# STRC slide: server-only base URL of the service that exposes /api/data (Express or other).
# The Next.js app exposes /api/strc/data and proxies here. For a single process, port that logic into app/api/strc/data/route.ts and omit this.
# Example local: STRC_UPSTREAM_URL=http://127.0.0.1:3001
STRC_UPSTREAM_URL=

# Optional: Slack Webhook URL for error alerts
# Enable only in production:
# SLACK_ALERTS_ENABLED=false (preview/local)
# SLACK_ALERTS_ENABLED=true (production)
# SLACK_ALERTS_ENABLED=false
# SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL_HERE
