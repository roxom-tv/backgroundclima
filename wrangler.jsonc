{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "backgroundclima",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "backgroundclima-production"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "backgroundclima-opennext-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "FX_API_URL": "https://api.exchangerate.host/latest",
    "OPENWEATHER_LANG": "en",
    "OPENWEATHER_UNITS": "metric",
    "SLACK_ALERTS_ENABLED": "false",
    "STRC_UPSTREAM_URL": "https://strc-dashboard-dev.external.workers.dev"
  },
  "env": {
    "preview": {
      "vars": {
        "NEXT_PUBLIC_SUPABASE_URL": "SET_IN_CLOUDFLARE_ENV",
        "FX_API_URL": "https://api.exchangerate.host/latest",
        "OPENWEATHER_LANG": "en",
        "OPENWEATHER_UNITS": "metric",
        "SLACK_ALERTS_ENABLED": "false",
        "STRC_UPSTREAM_URL": "https://strc-dashboard-dev.external.workers.dev"
      },
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "backgroundclima-preview" }
      ],
      "r2_buckets": [
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "backgroundclima-opennext-cache" }
      ],
      "images": { "binding": "IMAGES" }
    },
    "production": {
      "vars": {
        "NEXT_PUBLIC_SUPABASE_URL": "SET_IN_CLOUDFLARE_ENV",
        "FX_API_URL": "https://api.exchangerate.host/latest",
        "OPENWEATHER_LANG": "en",
        "OPENWEATHER_UNITS": "metric",
        "SLACK_ALERTS_ENABLED": "true",
        "STRC_UPSTREAM_URL": "https://strc.roxom.tv"
      },
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "backgroundclima-production" }
      ],
      "r2_buckets": [
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "backgroundclima-opennext-cache" }
      ],
      "images": { "binding": "IMAGES" }
    }
  }
}
