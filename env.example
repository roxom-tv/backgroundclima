# OpenWeatherMap API Configuration
# REQUIRED: Get your free API key from https://openweathermap.org/api
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY_HERE
# Optional: Units (metric, imperial, kelvin) - default: metric
OPENWEATHER_UNITS=metric
# Optional: Language code (en, es, etc.) - default: en
OPENWEATHER_LANG=en

# Market Data APIs Configuration
# REQUIRED for market slides (Gold, Silver, Oil, FX) to display real data

# Metals API (Gold & Silver)
# Get your API key from https://metals.dev/
# Free tier: 50 requests/day
METALS_API_URL=https://api.metals.dev
METALS_API_KEY=CZS9LZJVDI46F5GI7Q1J261GI7Q1J

# Oil API (WTI & Brent Crude Oil)
# Get your API key from https://oilpriceapi.com/
# Free tier: 100 requests/day
OIL_API_URL=https://api.oilpriceapi.com/v1/prices/latest
OIL_API_KEY=209bd4e65119aa3c3bf15592262ee184817c8a06e73ac6365e3af3842d898c7f

# FX API (Foreign Exchange - EUR, JPY, GBP, ARS)
# exchangerate.host - Free tier available (no key required for basic usage)
# Or use a paid service like exchangerate-api.com, fixer.io, etc.
# If using exchangerate.host free tier, leave FX_API_URL as is and OIL_API_KEY will be ignored for FX
FX_API_URL=https://api.exchangerate.host/latest
FX_API_KEY=83f5b7026bdd172ff8ecc94739f5743c

# Optional: Custom rotation interval in seconds (default: 25 seconds from config/cities.ts)
ROTATION_SECONDS=25

# Optional: Slack Webhook URL for error alerts
# SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL_HERE
