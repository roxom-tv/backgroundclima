{
    "$schema": "node_modules/wrangler/config-schema.json",
    "main": ".open-next/worker.js",
    "name": "backgroundclima",
    "compatibility_date": "2026-03-10",
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "backgroundclima-production",
        },
    ],
    "r2_buckets": [
        {
            "binding": "NEXT_INC_CACHE_R2_BUCKET",
            "bucket_name": "backgroundclima-opennext-cache",
        },
    ],
    "images": {
        "binding": "IMAGES",
    },
    "observability": {
        "enabled": true,
    },
    "env": {
        "preview": {
            "services": [
                { "binding": "WORKER_SELF_REFERENCE", "service": "backgroundclima-preview" },
            ],
            "r2_buckets": [
                {
                    "binding": "NEXT_INC_CACHE_R2_BUCKET",
                    "bucket_name": "backgroundclima-opennext-cache",
                },
            ],
            "images": { "binding": "IMAGES" },
        },
        "production": {
            "services": [
                { "binding": "WORKER_SELF_REFERENCE", "service": "backgroundclima-production" },
            ],
            "r2_buckets": [
                {
                    "binding": "NEXT_INC_CACHE_R2_BUCKET",
                    "bucket_name": "backgroundclima-opennext-cache",
                },
            ],
            "images": { "binding": "IMAGES" },
        },
    },
}
